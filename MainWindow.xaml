<Window x:Class="Quick_Alt_Tab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Alt Tab Resolution"
        Height="261"
        Width="354"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True">
    <Window.Resources>
        <!-- Shadcn-style UI Resources -->

        <!-- Gradient Brush -->
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7B61FF" Offset="0"/>
            <GradientStop Color="#4DA3FF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Shadcn Input Style -->
        <Style x:Key="ShadcnInput" TargetType="Border">
            <Setter Property="Background" Value="#171519"/>
            <Setter Property="BorderBrush" Value="#332f3a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#5a5163"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Shadcn TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI, Inter"/>
            <Setter Property="CaretBrush" Value="#FAFAFA"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="#211f24" CornerRadius="4" Width="8">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="#FAFAFA">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="#171519"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#2a2630"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#171519"/>
            <Setter Property="BorderBrush" Value="#5a5163"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                                                        <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          FocusVisualStyle="{x:Null}"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsTabStop="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="toggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="5">
                                            <Grid>
                                                <ContentPresenter IsHitTestVisible="False"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  Margin="6,0,16,0"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Center"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                <TextBlock Text="&#x25BE;"
                                                           Foreground="#A1A1AA"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="toggleBorder" Property="BorderBrush" Value="#5a5163"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="toggleBorder" Property="BorderBrush" Value="#5a5163"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#171519"
                                        BorderBrush="#5a5163"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer Margin="3" MaxHeight="120">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="#5a5163"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shadcn Primary Button with Glare Effect -->
        <Style x:Key="ShadcnButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#332f3a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,1,16,0"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                ClipToBounds="True">
                            <Grid>
                                <!-- Glare Effect Layer -->
                                <Rectangle x:Name="glare"
                                          Fill="White"
                                          Opacity="0"
                                          RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform>
                                        <TransformGroup>
                                            <SkewTransform AngleX="-20"/>
                                            <TranslateTransform X="-200"/>
                                        </TransformGroup>
                                    </Rectangle.RenderTransform>
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="White" Offset="0.4"/>
                                            <GradientStop Color="White" Offset="0.6"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>

                                <ContentPresenter x:Name="content"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#5a5163"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="GlareHoverStoryboard">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glare"
                                                           Storyboard.TargetProperty="Opacity"
                                                           To="0.2"
                                                           Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="glare"
                                                           Storyboard.TargetProperty="(Rectangle.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                           To="400"
                                                           Duration="0:0:0.65">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="GlareHoverStoryboard"/>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glare"
                                                           Storyboard.TargetProperty="Opacity"
                                                           To="0"
                                                           Duration="0:0:0"/>
                                            <DoubleAnimation Storyboard.TargetName="glare"
                                                           Storyboard.TargetProperty="(Rectangle.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                           To="-200"
                                                           Duration="0:0:0"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success State Button Style -->
        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="#09090B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,1,16,0"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button Style -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#71717A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <TextBlock Text="&#x2715;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#18181B"/>
                                <Setter Property="Foreground" Value="#FAFAFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimize Button Style -->
        <Style x:Key="MinimizeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#71717A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <TextBlock Text="&#x2500;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Margin="0,-4,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#18181B"/>
                                <Setter Property="Foreground" Value="#FAFAFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container -->
    <Border x:Name="MainBorder"
            Margin="2"
            CornerRadius="12"
            BorderBrush="#4A4554"
            BorderThickness="1"
            Background="#121114"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="30" ShadowDepth="0"/>
        </Border.Effect>

        <Grid x:Name="SurfaceGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="#171519"
                    CornerRadius="12,12,0,0"
                    BorderBrush="#4A4554"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Button x:Name="MonitorButton"
                            Background="Transparent"
                            Foreground="#71717A"
                            BorderThickness="0"
                            Width="30"
                            Height="24"
                            Cursor="Hand"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,0"
                            Click="MonitorButton_Click"
                            ToolTip="Select monitor">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                    <Grid Width="16" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="14"
                                                Height="9"
                                                BorderBrush="{TemplateBinding Foreground}"
                                                BorderThickness="1.2"
                                                CornerRadius="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top"/>
                                        <Rectangle Width="1.3"
                                                   Height="3.2"
                                                   Fill="{TemplateBinding Foreground}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Bottom"
                                                   Margin="0,0,0,1.8"/>
                                        <Rectangle Width="7.5"
                                                   Height="1.2"
                                                   Fill="{TemplateBinding Foreground}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Bottom"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#18181B"/>
                                        <Setter Property="Foreground" Value="#FAFAFA"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SettingsButton"
                                Content="&#x2699;"
                                Background="Transparent"
                                Foreground="#A1A1AA"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Width="28"
                                Height="28"
                                FontSize="14"
                                Cursor="Hand"
                                Margin="0,0,4,0"
                                Click="SettingsButton_Click"
                                ToolTip="Resolution settings">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="14"
                                            Width="{TemplateBinding Width}"
                                            Height="{TemplateBinding Height}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#5a5163"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource MinimizeButton}"
                                Width="28"
                                Height="28"
                                Margin="0,0,4,0"
                                Click="MinimizeButton_Click"/>
                        <Button x:Name="CloseButton"
                                Style="{StaticResource CloseButton}"
                                Width="28"
                                Height="28"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid x:Name="ContentGrid" Grid.Row="1" Margin="24,14,24,8" ClipToBounds="False">
                <StackPanel x:Name="MainFormPanel">
                    <!-- Native Resolution Section -->
                    <TextBlock Text="Native"
                               Style="{StaticResource SectionHeader}"/>

                    <Grid Margin="0,0,0,12" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Width -->
                        <Border Grid.Column="0" Style="{StaticResource ShadcnInput}" Width="88">
                            <TextBox x:Name="NativeWidth" Text="2560"/>
                        </Border>

                        <!-- X separator -->
                        <TextBlock Grid.Column="1"
                                   Text="&#x00D7;"
                                   Foreground="#71717A"
                                   FontSize="16"
                                   Margin="8,0"
                                   VerticalAlignment="Center"/>

                        <!-- Height -->
                        <Border Grid.Column="2" Style="{StaticResource ShadcnInput}" Width="88">
                            <TextBox x:Name="NativeHeight" Text="1440"/>
                        </Border>

                        <!-- Refresh Rate -->
                        <Border Grid.Column="4" Style="{StaticResource ShadcnInput}" Width="58">
                            <TextBox x:Name="NativeRefreshRate" Text="165"/>
                        </Border>

                        <TextBlock Grid.Column="5"
                                   Text="Hz"
                                   Foreground="#71717A"
                                   FontSize="13"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Custom Resolution Section -->
                    <TextBlock Text="Custom"
                               Style="{StaticResource SectionHeader}"/>

                    <Grid Margin="0,0,0,14" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Width -->
                        <Border Grid.Column="0" Style="{StaticResource ShadcnInput}" Width="88">
                            <TextBox x:Name="CustomWidth" Text=""/>
                        </Border>

                        <!-- X separator -->
                        <TextBlock Grid.Column="1"
                                   Text="&#x00D7;"
                                   Foreground="#71717A"
                                   FontSize="16"
                                   Margin="8,0"
                                   VerticalAlignment="Center"/>

                        <!-- Height -->
                        <Border Grid.Column="2" Style="{StaticResource ShadcnInput}" Width="88">
                            <TextBox x:Name="CustomHeight" Text=""/>
                        </Border>
                    </Grid>

                    <!-- Status Section -->
                    <Border x:Name="StatusBorder"
                            Background="#171519"
                            BorderBrush="#5F586A"
                            BorderThickness="0"
                            CornerRadius="6"
                            Padding="0"
                            Margin="0"
                            Height="0"
                            Visibility="Collapsed"
                            IsHitTestVisible="False">
                        <TextBlock x:Name="StatusText"
                                   Foreground="#A1A1AA"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Apply Button -->
                    <Button x:Name="ApplyButton"
                            Content="Apply"
                            Style="{StaticResource ShadcnButton}"
                            HorizontalAlignment="Stretch"
                            Click="ApplyButton_Click"/>
                </StackPanel>

                <Border x:Name="SettingsPanel"
                        Visibility="Collapsed"
                        Background="#171519"
                        BorderBrush="#5a5163"
                        BorderThickness="1.2"
                        CornerRadius="6"
                        Width="294"
                        Height="175"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,24,0,0"
                        Panel.ZIndex="10"
                        UseLayoutRounding="True"
                        SnapsToDevicePixels="True">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Resolutions"
                                   Foreground="#A1A1AA"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ResolutionListPanel"/>
                        </ScrollViewer>

                        <TextBlock x:Name="SettingsStatusText"
                                   Grid.Row="2"
                                   Visibility="Collapsed"
                                   Foreground="#A1A1AA"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,6,0,0"/>
                    </Grid>
                </Border>

                <Border x:Name="MonitorPanel"
                        Visibility="Collapsed"
                        Background="#171519"
                        BorderBrush="#5a5163"
                        BorderThickness="1.2"
                        CornerRadius="6"
                        Width="294"
                        Height="145"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,24,0,0"
                        Panel.ZIndex="12"
                        UseLayoutRounding="True"
                        SnapsToDevicePixels="True">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Monitors"
                                   Foreground="#A1A1AA"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="MonitorListPanel"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="TrialOverlay"
                    Grid.RowSpan="2"
                    Visibility="Collapsed"
                    Background="#121114CC"
                    Opacity="0"
                    Panel.ZIndex="50">
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="260">
                        <TextBlock x:Name="TrialOverlayTitle"
                                   Text="Confirm preset"
                                   Foreground="#FFFFFF"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="TrialOverlayBody"
                                   Text="Press Y to save, N to cancel"
                                   Foreground="#FFFFFF"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
